# Template. Copy to .env and fill in your own values — .env is gitignored.
# No real values belong in this file; it exists so both of us know which
# settings the app needs.

# With the school server + SSH tunnel, host is localhost and port is the local
# end of the tunnel:
#   ssh -L 5433:localhost:<remote-pg-port> <user>@<school-server> -N
DB_HOST=localhost
DB_PORT=5433

DB_NAME=
DB_USER=
DB_PASSWORD=
