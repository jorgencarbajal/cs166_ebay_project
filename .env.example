# Template. Copy to .env and fill in your own values — .env is gitignored.
# No real values belong in this file; it exists so both of us know which settings the app needs.

# The app runs on the school server, on the same machine as Postgres, so the host is always localhost. There is no SSH tunnel.
DB_HOST=localhost

# Your own instance's port. Find it on the server with: echo $PGPORT
DB_PORT=

# Your project database. List what exists with: cs166_psql -d postgres -l
# Capitalization is literal — jcarb044_DB is not the same as jcarb044_db.
DB_NAME=

# Your NetID.
DB_USER=

# Leave empty — the class instances use trust authentication. The key must still be present or the app raises KeyError.
DB_PASSWORD=
